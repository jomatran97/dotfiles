# core/zshenv normally sets these; fall back so a bare shell still works.
: ${XDG_CACHE_HOME:=$HOME/.cache} ${XDG_STATE_HOME:=$HOME/.local/state}
: ${ZSH_CONFIG_ROOT:=${${(%):-%x}:A:h}} ${ZSH:=$HOME/.oh-my-zsh}
typeset -g ZSH_STATE_DIR="$XDG_STATE_HOME/zsh"
typeset -g ZSH_CACHE_DIR="$XDG_CACHE_HOME/zsh"
if [[ ! -d $ZSH_STATE_DIR || ! -d $ZSH_CACHE_DIR ]]; then
  command mkdir -p "$ZSH_STATE_DIR" "$ZSH_CACHE_DIR"
  command chmod 700 "$ZSH_STATE_DIR" "$ZSH_CACHE_DIR"
fi

HISTFILE="$ZSH_STATE_DIR/history"
HISTSIZE=100000
SAVEHIST=100000

setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE
setopt AUTOCD NOBEEP NUMERIC_GLOB_SORT

if (( ! ${+ZSH_COMPDUMP} )); then
  typeset -g ZSH_COMPDUMP="$ZSH_CACHE_DIR/zcompdump-$ZSH_VERSION"
fi

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':omz:update' mode disabled

# Register the custom widget before plugin wrappers are installed.
source "$ZSH_CONFIG_ROOT/custom/fzf.zsh"
source "$ZSH_CONFIG_ROOT/custom/cache.zsh"

# fast-syntax-highlighting must stay last so it wraps widgets from earlier plugins.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=200
plugins=(
  dotenv
  zsh-autosuggestions
  zsh-syntax-highlighting
)

ZSH_THEME=''

[[ -o interactive ]] && _zsh_cached_init fzf --zsh

if [[ -r $ZSH/oh-my-zsh.sh ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 "zshrc: oh-my-zsh not found at $ZSH; install: sh -c \"\$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\" \"\" --unattended"
fi
source "$ZSH_CONFIG_ROOT/custom/aliases.zsh"
source "$ZSH_CONFIG_ROOT/custom/compat.zsh"

# OMZ and fzf may install bindings after the custom widget is registered.
if [[ -o interactive ]]; then
  bindkey '^F' _fzf_file_no_hidden
fi

# Single zoxide init (the OMZ zoxide plugin is intentionally not loaded).
[[ -o interactive ]] && _zsh_cached_init zoxide init zsh
[[ -o interactive ]] && _zsh_cached_init starship init zsh
