#!/bin/sh

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
CONFIG_DIR="${HOME}/.config/yabai"
SPACE_COUNT=6
SKETCHYBAR_SPACES_EVENT="yabai_spaces_change"
SKETCHYBAR_FRONT_APP_EVENT="yabai_front_app_change"

PERSONAL_CHAT_APPS='(Zalo|WhatsApp|Messages|iMessage|Signal|Telegram)'
WORK_CHAT_APPS='(Slack|Microsoft Teams( classic)?|Teams)'
TERMINAL_APPS='(Terminal|iTerm2|Alacritty|Ghostty|WezTerm|kitty|Warp|Claude)'
DESKTOP_3_APPS='(Code|Visual Studio Code|Arc|Brave|Brave Browser|Firefox|Postman)'
NOTES_APPS='(Notes|Obsidian)'
PASSWORD_APPS='(1Password|Bitwarden)'

ensure_space_count() {
  target=$1
  current=$(yabai -m query --spaces --display | grep -o '"index"' | wc -l | tr -d ' ')

  while [ "$current" -lt "$target" ]; do
    yabai -m space --create >/dev/null 2>&1 || break
    current=$((current + 1))
  done
}

add_rule() {
  label=$1
  shift

  yabai -m rule --remove "$label" >/dev/null 2>&1 || true
  yabai -m rule --add label="$label" "$@"
}

# Keep the core workflow on features that work without the optional scripting addition.
yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config window_zoom_persist off

yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

yabai -m config top_padding 6
yabai -m config left_padding 12
yabai -m config right_padding 12
yabai -m config bottom_padding 12
yabai -m config window_gap 12
yabai -m config external_bar all:36:0

# Keep the managed desktop count aligned with skhd/sketchybar.
ensure_space_count "$SPACE_COUNT"

# yabai applies all matching rules in registration order, with later rules
# overriding earlier values, so add the catch-all first and let the more
# specific app groups override desktop 6 when they match.
add_rule space_default app=".*" space=6
add_rule space_personal_chat app="$PERSONAL_CHAT_APPS" space=1
add_rule space_terminal app="$TERMINAL_APPS" space=2
add_rule space_ide app="$DESKTOP_3_APPS" space=3
add_rule space_notes app="$NOTES_APPS" space=4
add_rule space_password app="$PASSWORD_APPS" space=4
add_rule space_work_chat app="$WORK_CHAT_APPS" space=5

# Conservative app-specific rules: obvious utility/system apps float better than tile.
add_rule float_system app="^(System Settings|System Preferences|Activity Monitor|Archive Utility|Calculator|Font Book|Disk Utility|System Information)$" manage=off
add_rule sticky_digital_colour_meter app="^Digital Colou?r Meter$" manage=off sticky=on
add_rule sticky_picture_in_picture app="^Picture-in-Picture$" manage=off sticky=on

signal_action() {
  trigger=$1
  printf '%s\n' "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:\$PATH; if command -v sketchybar >/dev/null 2>&1; then sketchybar --trigger $trigger; fi"
}

script_action() {
  script_name=$1
  printf '%s\n' "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:\$PATH; \"$CONFIG_DIR/bin/$script_name\""
}

add_signal() {
  event=$1
  trigger=$2
  label="sketchybar_${event}_${trigger}"

  yabai -m signal --remove "$label" >/dev/null 2>&1 || true
  yabai -m signal --add event="$event" action="$(signal_action "$trigger")" label="$label"
}

add_script_signal() {
  event=$1
  script_name=$2
  label=$3

  yabai -m signal --remove "$label" >/dev/null 2>&1 || true
  yabai -m signal --add event="$event" action="$(script_action "$script_name")" label="$label"
}

# Follow newly created windows to their assigned desktop; floating windows are centered by the helper.
add_script_signal window_created follow-new-window yabai_window_created_follow_new_window

# Split SketchyBar refreshes so all spaces do not need to rerender for every
# focus/title/resize change.
add_signal display_added "$SKETCHYBAR_SPACES_EVENT"
add_signal display_removed "$SKETCHYBAR_SPACES_EVENT"
add_signal display_changed "$SKETCHYBAR_SPACES_EVENT"
add_signal space_created "$SKETCHYBAR_SPACES_EVENT"
add_signal space_destroyed "$SKETCHYBAR_SPACES_EVENT"
add_signal space_changed "$SKETCHYBAR_SPACES_EVENT"
add_signal window_created "$SKETCHYBAR_SPACES_EVENT"
add_signal window_destroyed "$SKETCHYBAR_SPACES_EVENT"
add_signal window_minimized "$SKETCHYBAR_SPACES_EVENT"
add_signal window_deminimized "$SKETCHYBAR_SPACES_EVENT"
add_signal window_moved "$SKETCHYBAR_SPACES_EVENT"

add_signal application_front_switched "$SKETCHYBAR_FRONT_APP_EVENT"
add_signal display_changed "$SKETCHYBAR_FRONT_APP_EVENT"
add_signal space_changed "$SKETCHYBAR_FRONT_APP_EVENT"
add_signal window_created "$SKETCHYBAR_FRONT_APP_EVENT"
add_signal window_destroyed "$SKETCHYBAR_FRONT_APP_EVENT"
add_signal window_focused "$SKETCHYBAR_FRONT_APP_EVENT"
add_signal window_minimized "$SKETCHYBAR_FRONT_APP_EVENT"
add_signal window_deminimized "$SKETCHYBAR_FRONT_APP_EVENT"
add_signal window_moved "$SKETCHYBAR_FRONT_APP_EVENT"

# Re-apply rules so existing windows are reorganized after a restart or config reload.
yabai -m rule --apply >/dev/null 2>&1 || true

if command -v sketchybar >/dev/null 2>&1; then
  sketchybar --trigger "$SKETCHYBAR_SPACES_EVENT"
  sketchybar --trigger "$SKETCHYBAR_FRONT_APP_EVENT"
fi

# Some apps need a brief moment after a service restart before they can be
# re-matched reliably, so do a second pass shortly afterwards.
(
  sleep 1
  yabai -m rule --apply >/dev/null 2>&1 || true
  if command -v sketchybar >/dev/null 2>&1; then
    sketchybar --trigger "$SKETCHYBAR_SPACES_EVENT"
    sketchybar --trigger "$SKETCHYBAR_FRONT_APP_EVENT"
  fi
) >/dev/null 2>&1 &
