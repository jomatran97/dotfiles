#!/bin/sh

set -u

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

direction=${1:-}
step=${2:-40}

resize() {
  yabai -m window --resize "$1" >/dev/null 2>&1
}

case "$direction" in
  west|left|h)
    resize "left:-$step:0" || resize "right:-$step:0" || :
    ;;
  east|right|l)
    resize "right:$step:0" || resize "left:$step:0" || :
    ;;
  north|up|k)
    resize "top:0:-$step" || resize "bottom:0:-$step" || :
    ;;
  south|down|j)
    resize "bottom:0:$step" || resize "top:0:$step" || :
    ;;
  *)
    exit 64
    ;;
esac
