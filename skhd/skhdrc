# Raycast Hyper key = cmd + alt + ctrl + shift
# Primary actions stay on Hyper. Secondary actions use modes so they do not
# conflict with Hyper already including Shift.

:: default : ~/.config/skhd/bin/set-mode default
:: swap @ : ~/.config/skhd/bin/set-mode swap
:: display @ : ~/.config/skhd/bin/set-mode display
:: send @ : ~/.config/skhd/bin/set-mode send
:: resize @ : ~/.config/skhd/bin/set-mode resize
:: warp @ : ~/.config/skhd/bin/set-mode warp

# Leave secondary modes.
swap < escape ; default
display < escape ; default
send < escape ; default
resize < escape ; default
warp < escape ; default
swap < s ; default
display < d ; default
send < m ; default
resize < e ; default
warp < w ; default

# Launch the default terminal for this repo.
default < cmd + alt + ctrl + shift - return : open -a Ghostty

# Focus windows with vim-style directions.
default < cmd + alt + ctrl + shift - h : ~/.config/skhd/bin/yabai-msg window --focus west || :
default < cmd + alt + ctrl + shift - j : ~/.config/skhd/bin/yabai-msg window --focus south || :
default < cmd + alt + ctrl + shift - k : ~/.config/skhd/bin/yabai-msg window --focus north || :
default < cmd + alt + ctrl + shift - l : ~/.config/skhd/bin/yabai-msg window --focus east || :

# Enter secondary modes.
default < cmd + alt + ctrl + shift - s ; swap
default < cmd + alt + ctrl + shift - d ; display
default < cmd + alt + ctrl + shift - m ; send
default < cmd + alt + ctrl + shift - e ; resize
default < cmd + alt + ctrl + shift - w ; warp

# Swap mode: h/j/k/l swap windows. Press Escape or s to leave the mode.
swap < h : ~/.config/skhd/bin/yabai-msg window --swap west || :
swap < j : ~/.config/skhd/bin/yabai-msg window --swap south || :
swap < k : ~/.config/skhd/bin/yabai-msg window --swap north || :
swap < l : ~/.config/skhd/bin/yabai-msg window --swap east || :

# Display mode: h/l focus prev/next display. Press Escape or d to leave.
display < h : ~/.config/skhd/bin/yabai-msg display --focus prev || :
display < l : ~/.config/skhd/bin/yabai-msg display --focus next || :

# Focus spaces directly.
default < cmd + alt + ctrl + shift - 1 : ~/.config/skhd/bin/yabai-msg space --focus 1 || :
default < cmd + alt + ctrl + shift - 2 : ~/.config/skhd/bin/yabai-msg space --focus 2 || :
default < cmd + alt + ctrl + shift - 3 : ~/.config/skhd/bin/yabai-msg space --focus 3 || :
default < cmd + alt + ctrl + shift - 4 : ~/.config/skhd/bin/yabai-msg space --focus 4 || :
default < cmd + alt + ctrl + shift - 5 : ~/.config/skhd/bin/yabai-msg space --focus 5 || :
default < cmd + alt + ctrl + shift - 6 : ~/.config/skhd/bin/yabai-msg space --focus 6 || :

# Send mode: h/l move the focused window between displays, 1..6 send it to a
# space and follow it. Press Escape or m to leave.
send < h : ~/.config/skhd/bin/yabai-msg window --display prev && ~/.config/skhd/bin/yabai-msg display --focus prev
send < l : ~/.config/skhd/bin/yabai-msg window --display next && ~/.config/skhd/bin/yabai-msg display --focus next
send < 1 : ~/.config/skhd/bin/yabai-msg window --space 1 && ~/.config/skhd/bin/yabai-msg space --focus 1
send < 2 : ~/.config/skhd/bin/yabai-msg window --space 2 && ~/.config/skhd/bin/yabai-msg space --focus 2
send < 3 : ~/.config/skhd/bin/yabai-msg window --space 3 && ~/.config/skhd/bin/yabai-msg space --focus 3
send < 4 : ~/.config/skhd/bin/yabai-msg window --space 4 && ~/.config/skhd/bin/yabai-msg space --focus 4
send < 5 : ~/.config/skhd/bin/yabai-msg window --space 5 && ~/.config/skhd/bin/yabai-msg space --focus 5
send < 6 : ~/.config/skhd/bin/yabai-msg window --space 6 && ~/.config/skhd/bin/yabai-msg space --focus 6

# Resize mode: h/j/k/l grow the managed split in that direction.
resize < h : ~/.config/skhd/bin/yabai-resize west
resize < j : ~/.config/skhd/bin/yabai-resize south
resize < k : ~/.config/skhd/bin/yabai-resize north
resize < l : ~/.config/skhd/bin/yabai-resize east

# Warp mode: h/j/k/l reinsert the window around a neighbour; x/y mirror the
# space tree; r rotates it; b rebalances it.
warp < h : ~/.config/skhd/bin/yabai-msg window --warp west || :
warp < j : ~/.config/skhd/bin/yabai-msg window --warp south || :
warp < k : ~/.config/skhd/bin/yabai-msg window --warp north || :
warp < l : ~/.config/skhd/bin/yabai-msg window --warp east || :
warp < x : ~/.config/skhd/bin/yabai-msg space --mirror x-axis || :
warp < y : ~/.config/skhd/bin/yabai-msg space --mirror y-axis || :
warp < r : ~/.config/skhd/bin/yabai-msg space --rotate 90 || :
warp < b : ~/.config/skhd/bin/yabai-msg space --balance || :

# A few practical layout toggles.
default < cmd + alt + ctrl + shift - f : ~/.config/skhd/bin/yabai-msg window --toggle float
default < cmd + alt + ctrl + shift - z : ~/.config/skhd/bin/yabai-msg window --toggle zoom-parent
default < cmd + alt + ctrl + shift - x : ~/.config/skhd/bin/yabai-msg window --toggle zoom-fullscreen
default < cmd + alt + ctrl + shift - b : ~/.config/skhd/bin/yabai-msg space --balance
default < cmd + alt + ctrl + shift - r : ~/.config/skhd/bin/yabai-msg space --rotate 90
default < cmd + alt + ctrl + shift - p : ~/.config/skhd/bin/yabai-msg window --toggle split
