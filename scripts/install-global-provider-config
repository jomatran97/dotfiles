#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

SCRIPT_NAME="$(basename "$0")"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOME_DIR="${HOME:?HOME must be set}"
DRY_RUN=0
FORCE=0
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
BACKUP_DIR="$REPO_ROOT/state/backups/global-provider-config/$TIMESTAMP"
BACKUP_READY=0
BACKED_UP_PATHS=$'\n'
ACTIONS=()
SKIPS=()
WARNINGS=()

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME [options]

Install provider source-of-truth assets from this repository into official
user/global config locations for Claude, Codex, and Antigravity.

Safe defaults:
  - creates missing files and directories
  - skips overwriting existing files unless --force is set
  - backs up each overwritten target before mutation
  - preserves existing shared Antigravity ~/.gemini files even with --force until schema-aware merge exists
  - warns and skips file targets whose destination path is a directory or non-restorable symlink
  - validates parent path components before mkdir -p and skips only conflicting targets
  - never copies obvious secret/auth files from this repository
  - warns and skips ambiguous mappings instead of guessing schema

Options:
  --dry-run               Show planned actions without mutating HOME
  --force                 Overwrite existing mapped files after backup
  --backup-dir DIR        Write backups to DIR instead of the default repo state path
  -h, --help              Show this help text

Official target paths used when source files exist:
  Claude:
    ~/.claude/settings.json
    ~/.claude/agents/
    ~/.claude/skills/
    ~/.claude/hooks/
    skipped with warning: claude/CLAUDE.md, claude/mcp/*, ambiguous extra settings files

  Codex:
    ~/.codex/config.toml
    ~/.codex/*.config.toml
    ~/.codex/hooks.json
    ~/.codex/AGENTS.md
    skipped with warning: codex/agents/*.md except AGENTS.md, prompts/templates without verified global path

  Antigravity:
    ~/.gemini/antigravity-cli/settings.json
    ~/.gemini/config/hooks.json
    ~/.gemini/config/mcp_config.json
    WARNING: these paths are shared global Gemini/Antigravity state
    existing files at these paths are preserved/skipped even with --force until schema-aware merge exists
    skipped with warning: agents/prompts/artifacts and ambiguous files

Examples:
  ./$SCRIPT_NAME --dry-run
  ./$SCRIPT_NAME --force
  ./$SCRIPT_NAME --backup-dir ./state/backups/manual-install --force
EOF
}

record_action() {
  ACTIONS+=("$1")
  printf 'ACTION: %s\n' "$1"
}

record_skip() {
  SKIPS+=("$1")
  printf 'SKIP: %s\n' "$1"
}

record_warning() {
  WARNINGS+=("$1")
  printf 'WARNING: %s\n' "$1" >&2
}

contains_line() {
  local haystack="$1"
  local needle="$2"
  case "$haystack" in
    *$'\n'"$needle"$'\n'*) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_backup_dir() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    return 0
  fi
  if [[ "$BACKUP_READY" -eq 0 ]]; then
    mkdir -p "$BACKUP_DIR"
    BACKUP_READY=1
  fi
}

backup_target() {
  local target="$1"
  local relative backup_path

  if [[ ! -e "$target" && ! -L "$target" ]]; then
    return 0
  fi
  if contains_line "$BACKED_UP_PATHS" "$target"; then
    return 0
  fi

  if [[ "$target" == "$HOME_DIR" ]]; then
    relative="HOME"
  elif [[ "$target" == "$HOME_DIR/"* ]]; then
    relative="${target#$HOME_DIR/}"
  else
    relative="${target#/}"
  fi
  backup_path="$BACKUP_DIR/$relative"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    record_action "[dry-run] backup $target -> $backup_path"
    BACKED_UP_PATHS+="$target"$'\n'
    return 0
  fi

  ensure_backup_dir
  mkdir -p "$(dirname "$backup_path")"
  cp -PRp "$target" "$backup_path"
  BACKED_UP_PATHS+="$target"$'\n'
  record_action "backup $target -> $backup_path"
}

ensure_parent_dir() {
  local parent="$1"
  local label="$2"
  local dest="$3"
  local current remainder component

  if [[ -d "$parent" ]]; then
    return 0
  fi

  if [[ "$parent" != "/" ]]; then
    current=""
    remainder="$parent"
    if [[ "$parent" == /* ]]; then
      current="/"
      remainder="${parent#/}"
    fi
    IFS='/' read -r -a components <<< "$remainder"
    for component in "${components[@]}"; do
      [[ -n "$component" ]] || continue
      if [[ "$current" == "/" ]]; then
        current="/$component"
      elif [[ -n "$current" ]]; then
        current="$current/$component"
      else
        current="$component"
      fi

      if [[ -e "$current" || -L "$current" ]]; then
        if [[ -d "$current" ]]; then
          continue
        fi
        record_warning "$label: parent path component is not a directory or symlink to a directory; skipping target: $dest (conflict: $current)"
        record_skip "$label: rejected parent path conflict: $dest"
        return 1
      fi
    done
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    record_action "[dry-run] mkdir -p $parent"
    return 0
  fi
  mkdir -p "$parent"
  record_action "mkdir -p $parent"
}

is_secret_like_path() {
  local path="$1"
  local base lower
  base="$(basename "$path")"
  lower="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    .gitkeep|.ds_store) return 0 ;;
    settings.local.json|auth.json|credentials.json|token.json|tokens.json|oauth.json|session.json) return 0 ;;
    .env|.env.*) return 0 ;;
    *.pem|*.key|*.p12|*.pfx|*.crt|*.cer) return 0 ;;
    id_rsa|id_rsa.pub|id_ed25519|id_ed25519.pub) return 0 ;;
    *secret*|*credential*|*token*|*oauth*|*session*) return 0 ;;
    *) return 1 ;;
  esac
}

validate_file_destination() {
  local dest="$1"
  local label="$2"

  if [[ -d "$dest" ]]; then
    record_warning "$label: target path is a directory or symlink to a directory; skipping file install: $dest"
    record_skip "$label: rejected non-file destination: $dest"
    return 1
  fi

  if [[ -L "$dest" ]]; then
    record_warning "$label: target path is a symlink to a file or other non-directory; skipping file install because overwrite would not be safely restorable: $dest"
    record_skip "$label: rejected non-restorable symlink destination: $dest"
    return 1
  fi

  return 0
}

copy_file() {
  local src="$1"
  local dest="$2"
  local label="$3"
  local existing_policy="${4:-force-overwrite}"

  if [[ ! -f "$src" ]]; then
    record_skip "$label: source file missing: $src"
    return 0
  fi
  if is_secret_like_path "$src"; then
    record_skip "$label: skipped secret-like or meta file: $src"
    return 0
  fi
  validate_file_destination "$dest" "$label" || return 0
  if [[ -e "$dest" || -L "$dest" ]]; then
    if [[ "$existing_policy" == "preserve-existing" ]]; then
      record_warning "$label: preserving existing shared Gemini state because schema-aware merge is not implemented: $dest"
      record_skip "$label: existing shared Gemini state preserved: $dest"
      return 0
    fi
    if [[ "$FORCE" -ne 1 ]]; then
      record_skip "$label: target exists and --force was not set: $dest"
      return 0
    fi
    backup_target "$dest"
  fi

  ensure_parent_dir "$(dirname "$dest")" "$label" "$dest" || return 0
  if [[ "$DRY_RUN" -eq 1 ]]; then
    record_action "[dry-run] install $label: $src -> $dest"
    return 0
  fi

  cp -p "$src" "$dest"
  record_action "install $label: $src -> $dest"
}

copy_dir_contents() {
  local src_dir="$1"
  local dest_dir="$2"
  local label="$3"
  local found=0
  local src rel

  if [[ ! -d "$src_dir" ]]; then
    record_skip "$label: source directory missing: $src_dir"
    return 0
  fi

  while IFS= read -r src; do
    if is_secret_like_path "$src"; then
      record_skip "$label: skipped secret-like or meta file: $src"
      continue
    fi
    rel="${src#$src_dir/}"
    found=1
    copy_file "$src" "$dest_dir/$rel" "$label/$rel"
  done < <(find "$src_dir" -type f | LC_ALL=C sort)

  if [[ "$found" -eq 0 ]]; then
    record_skip "$label: no installable files under $src_dir"
  fi
}

warn_if_present() {
  local path="$1"
  local message="$2"
  if [[ -f "$path" ]]; then
    record_warning "$message ($path)"
  elif [[ -d "$path" ]]; then
    if find "$path" -type f ! -name '.gitkeep' | grep -q .; then
      record_warning "$message ($path)"
    fi
  fi
}

install_claude() {
  local root="$REPO_ROOT/claude"
  local extra

  copy_file "$root/settings/settings.json" "$HOME_DIR/.claude/settings.json" "Claude settings"
  copy_dir_contents "$root/agents" "$HOME_DIR/.claude/agents" "Claude agents"
  copy_dir_contents "$root/skills" "$HOME_DIR/.claude/skills" "Claude skills"
  copy_dir_contents "$root/hooks" "$HOME_DIR/.claude/hooks" "Claude hooks"

  for extra in "$root/settings"/*; do
    [[ -e "$extra" ]] || continue
    if [[ "$(basename "$extra")" != "settings.json" ]] && ! is_secret_like_path "$extra"; then
      record_warning "Skipped Claude settings file without a verified user-scope target: $extra"
    fi
  done

  warn_if_present "$root/CLAUDE.md" "Skipped claude/CLAUDE.md because it is project guidance, not verified user-global config"
  warn_if_present "$root/mcp" "Skipped claude/mcp assets because official mapping is ambiguous between project .mcp.json and user ~/.claude.json"
}

install_codex() {
  local root="$REPO_ROOT/codex"
  local file

  copy_file "$root/config/config.toml" "$HOME_DIR/.codex/config.toml" "Codex config"
  for file in "$root"/config/*.config.toml; do
    copy_file "$file" "$HOME_DIR/.codex/$(basename "$file")" "Codex profile"
  done
  copy_file "$root/config/hooks.json" "$HOME_DIR/.codex/hooks.json" "Codex hooks"
  copy_file "$root/agents/AGENTS.md" "$HOME_DIR/.codex/AGENTS.md" "Codex AGENTS.md"

  for file in "$root"/agents/*.md; do
    [[ -e "$file" ]] || continue
    if [[ "$(basename "$file")" != "AGENTS.md" ]]; then
      record_warning "Skipped Codex agent prompt without a verified user-global target: $file"
    fi
  done

  warn_if_present "$root/prompts" "Skipped codex/prompts because no official user-global install path is verified"
  warn_if_present "$root/templates" "Skipped codex/templates because no official user-global install path is verified"
}

install_antigravity() {
  local root="$REPO_ROOT/antigravity"
  local file base

  record_warning "Antigravity writes target shared global Gemini state under ~/.gemini; review every planned change before using --force"
  copy_file "$root/settings/settings.json" "$HOME_DIR/.gemini/antigravity-cli/settings.json" "Antigravity settings" "preserve-existing"
  copy_file "$root/settings/hooks.json" "$HOME_DIR/.gemini/config/hooks.json" "Antigravity hooks" "preserve-existing"
  copy_file "$root/settings/mcp_config.json" "$HOME_DIR/.gemini/config/mcp_config.json" "Antigravity MCP config" "preserve-existing"

  for file in "$root"/settings/*; do
    [[ -e "$file" ]] || continue
    base="$(basename "$file")"
    case "$base" in
      settings.json|hooks.json|mcp_config.json) ;;
      *)
        if ! is_secret_like_path "$file"; then
          record_warning "Skipped Antigravity settings file without a verified shared-global target: $file"
        fi
        ;;
    esac
  done

  warn_if_present "$root/agents" "Skipped antigravity/agents because the official global agent/plugin path is not fully verified"
  warn_if_present "$root/prompts" "Skipped antigravity/prompts because the official global prompt path is not fully verified"
  warn_if_present "$root/artifacts" "Skipped antigravity/artifacts because artifacts are not safe global config assets"
}

print_summary() {
  printf '\nSummary:\n'
  printf '  repo root: %s\n' "$REPO_ROOT"
  printf '  home: %s\n' "$HOME_DIR"
  printf '  dry-run: %s\n' "$DRY_RUN"
  printf '  force: %s\n' "$FORCE"
  printf '  actions: %s\n' "${#ACTIONS[@]}"
  printf '  skips: %s\n' "${#SKIPS[@]}"
  printf '  warnings: %s\n' "${#WARNINGS[@]}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf '  backup dir: %s (not created in dry-run)\n' "$BACKUP_DIR"
  elif [[ "$BACKUP_READY" -eq 1 ]]; then
    printf '  backup dir: %s\n' "$BACKUP_DIR"
  else
    printf '  backup dir: not used\n'
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    --force)
      FORCE=1
      ;;
    --backup-dir)
      shift
      if [[ $# -eq 0 ]]; then
        printf 'ERROR: --backup-dir requires a value\n' >&2
        exit 2
      fi
      BACKUP_DIR="$1"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'ERROR: unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

install_claude
install_codex
install_antigravity
print_summary
