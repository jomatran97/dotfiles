;; GokuRakuJoudo config for Karabiner-Elements.
;; Caps Lock becomes Hyper (⌘⌃⌥⇧) when held, Escape when tapped.

{:profiles {:Default {:default true
                      ;; Keep tap-vs-hold responsive while avoiding accidental Esc.
                      :alone 200
                      :held 200}}

 :main [{:des "Caps Lock: Hyper when held, Escape when tapped"
         :rules [[:##caps_lock :!CTOleft_shift nil {:alone :escape}]]}]}
