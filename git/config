# ~/.config/git/config

# Optional per-machine overrides such as signing keys live in
# ~/.config/git/config.local. Missing include files are ignored by Git.
[include]
    path = ~/.config/git/config.local

[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    dark = true
    hyperlinks = true

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default

[pull]
    rebase = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[rerere]
    enabled = true
    autoupdate = true

[gpg]
    format = ssh

[commit]
    gpgsign = true

[tag]
    gpgSign = true

[alias]
    dft = -c diff.external=difft diff
    dlog = -c diff.external=difft log -p --ext-diff
    dshow = -c diff.external=difft show --ext-diff
