#!/bin/sh

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

CONFIG_DIR=${CONFIG_DIR:-$HOME/.config/sketchybar}
PLUGIN_DIR="$CONFIG_DIR/plugins"
SPACES="1 2 3 4 5 6"
BT_DEVICE_SLOTS=10

# shellcheck source=./colors.sh
. "$CONFIG_DIR/colors.sh"

sketchybar --bar \
  position=top \
  height=36 \
  color="$BAR_COLOR" \
  border_color="$BAR_BORDER" \
  border_width=0 \
  blur_radius=28 \
  corner_radius=16 \
  margin=10 \
  y_offset=6 \
  padding_left=12 \
  padding_right=12 \
  font_smoothing=on \
  sticky=on \
  topmost=window \
  shadow=off

sketchybar --default \
  updates=when_shown \
  drawing=on \
  icon.font="SF Pro Text:Semibold:12.0" \
  label.font="SF Pro Text:Medium:12.0" \
  icon.color="$TEXT" \
  label.color="$TEXT" \
  background.drawing=off \
  background.color="$ITEM_BG" \
  background.border_color="$ITEM_BORDER" \
  background.border_width=1 \
  background.corner_radius=10 \
  background.height=28 \
  padding_left=4 \
  padding_right=4 \
  icon.padding_left=10 \
  icon.padding_right=4 \
  label.padding_left=0 \
  label.padding_right=10

sketchybar --add event yabai_spaces_change
sketchybar --add event yabai_front_app_change
sketchybar --add event skhd_mode_change

space_items=""
for sid in $SPACES; do
  name="space.$sid"
  space_items="$space_items $name"

  sketchybar --add item "$name" left \
    --set "$name" \
    SPACE_INDEX="$sid" \
    SPACE_ICON_LIMIT=4 \
    icon="$sid" \
    label="—" \
    drawing=off \
    click_script="PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH; yabai -m space --focus $sid"
done

sketchybar --add item spaces.worker left \
  --set spaces.worker \
  width=0 \
  padding_left=0 \
  padding_right=0 \
  icon.drawing=off \
  label.drawing=off \
  drawing=off \
  script="$PLUGIN_DIR/spaces.sh" \
  SPACE_LIST="$SPACES" \
  SPACE_ICON_LIMIT=4 \
  --subscribe spaces.worker yabai_spaces_change

# shellcheck disable=SC2086
sketchybar --add bracket workspaces $space_items \
  --set workspaces \
  background.drawing=on \
  background.color="$GROUP_BG" \
  background.border_color="$GROUP_BORDER" \
  background.border_width=1 \
  background.corner_radius=12 \
  background.height=30

sketchybar --add item skhd_mode left \
  --set skhd_mode \
  script="$PLUGIN_DIR/mode.sh" \
  icon="⌨" \
  icon.color="$PEACH" \
  label="MODE" \
  drawing=off \
  padding_left=8 \
  padding_right=8 \
  background.drawing=on \
  background.color="$GROUP_BG" \
  background.border_color="$GROUP_BORDER" \
  background.border_width=1 \
  background.corner_radius=12 \
  background.height=30 \
  --subscribe skhd_mode skhd_mode_change

sketchybar --add item focused_app left \
  --set focused_app \
  script="$PLUGIN_DIR/front_app.sh" \
  icon="⌂" \
  icon.drawing=on \
  icon.color="$MAUVE" \
  icon.padding_right=6 \
  label="Desktop" \
  width=220 \
  padding_left=12 \
  padding_right=12 \
  background.drawing=on \
  background.color="$GROUP_BG" \
  background.border_color="$GROUP_BORDER" \
  background.border_width=1 \
  background.corner_radius=12 \
  background.height=30 \
  --subscribe focused_app yabai_front_app_change

sketchybar --add item bluetooth right \
  --set bluetooth \
  icon="BT" \
  icon.color="$SKY" \
  label="--" \
  width=120 \
  update_freq=90 \
  script="$PLUGIN_DIR/bluetooth.sh" \
  click_script="$PLUGIN_DIR/bluetooth.sh --click" \
  popup.align=right \
  popup.height=30 \
  popup.y_offset=8 \
  popup.blur_radius=20 \
  popup.background.drawing=on \
  popup.background.color="$GROUP_BG" \
  popup.background.border_color="$GROUP_BORDER" \
  popup.background.border_width=1 \
  popup.background.corner_radius=12

sketchybar --add item bluetooth.status popup.bluetooth \
  --set bluetooth.status \
  icon="BT" \
  label="Bluetooth" \
  width=230 \
  click_script="$PLUGIN_DIR/bluetooth.sh --open-settings"

sketchybar --add item bluetooth.toggle popup.bluetooth \
  --set bluetooth.toggle \
  icon="PWR" \
  label="Toggle Bluetooth Power" \
  width=230 \
  click_script="$PLUGIN_DIR/bluetooth.sh --toggle-power"

sketchybar --add item bluetooth.note popup.bluetooth \
  --set bluetooth.note \
  icon="PKG" \
  label="brew install blueutil" \
  width=230 \
  drawing=off \
  click_script="$PLUGIN_DIR/bluetooth.sh --install-help"

for slot in $(seq 1 "$BT_DEVICE_SLOTS"); do
  name="bluetooth.device.$slot"

  sketchybar --add item "$name" popup.bluetooth \
    --set "$name" \
    icon="○" \
    label="—" \
    width=230 \
    drawing=off \
    click_script="$PLUGIN_DIR/bluetooth.sh --device"
done

sketchybar --add item bluetooth.action popup.bluetooth \
  --set bluetooth.action \
  icon="SET" \
  label="Open Bluetooth Settings" \
  width=230 \
  click_script="$PLUGIN_DIR/bluetooth.sh --open-settings"

sketchybar --add item power right \
  --set power \
  icon="BAT" \
  label="--%" \
  width=76 \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh"

sketchybar --add item time right \
  --set time \
  icon="TIME" \
  icon.color="$ROSEWATER" \
  label="--:--" \
  width=96 \
  update_freq=30 \
  script="$PLUGIN_DIR/clock.sh"

sketchybar --add bracket status_group bluetooth power time \
  --set status_group \
  background.drawing=on \
  background.color="$GROUP_BG" \
  background.border_color="$GROUP_BORDER" \
  background.border_width=1 \
  background.corner_radius=12 \
  background.height=30

sketchybar --subscribe bluetooth system_woke
sketchybar --subscribe power system_woke
sketchybar --subscribe time system_woke

sketchybar --update
sketchybar --trigger yabai_spaces_change
sketchybar --trigger yabai_front_app_change
sketchybar --trigger skhd_mode_change
