# Shared defaults for hcom multiagent wrappers. Safe to commit: no secrets.
DOTFILES="${DOTFILES:-/Users/ryanparker/Documents/personal/code/dotfiles}"
MULTIAGENT_RUNS="${MULTIAGENT_RUNS:-$HOME/state/multiagent/runs}"
# Relocated (non-dot) config homes. These are what make the ~/config/* symlinks
# take effect; without them the CLIs silently fall back to ~/.claude, ~/.codex, ~/.gemini.
CONFIG_HOME="${CONFIG_HOME:-$HOME/config}"
CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$CONFIG_HOME/claude}"
CODEX_HOME="${CODEX_HOME:-$CONFIG_HOME/codex}"
GEMINI_CONFIG_DIR="${GEMINI_CONFIG_DIR:-$CONFIG_HOME/gemini}"
# ONE fixed global hcom home. Never set this to a per-project ($PWD) path.
HCOM_DIR="${HCOM_DIR:-$CONFIG_HOME/hcom}"
MA_BIN="${MA_BIN:-$HOME/bin}"
APPROVAL_MODE="${APPROVAL_MODE:-manual}" # manual|auto
MAX_ITERATIONS="${MAX_ITERATIONS:-12}"
MAX_DISPATCHES="${MAX_DISPATCHES:-80}"
WALLCLOCK_BUDGET="${WALLCLOCK_BUDGET:-21600}" # seconds
RESEARCH_TIMEOUT="${RESEARCH_TIMEOUT:-1800}"
PLANNER_TIMEOUT="${PLANNER_TIMEOUT:-1800}"
SCOUT_TIMEOUT="${SCOUT_TIMEOUT:-1200}"
IMPLEMENTER_TIMEOUT="${IMPLEMENTER_TIMEOUT:-2400}"
REVIEWER_TIMEOUT="${REVIEWER_TIMEOUT:-1200}"
ARCHITECT_TIMEOUT="${ARCHITECT_TIMEOUT:-21600}"
HCOM_EVENT_SLICE="${HCOM_EVENT_SLICE:-30}"
BACKOFF_BASE="${BACKOFF_BASE:-5}"
BACKOFF_MAX="${BACKOFF_MAX:-60}"
